# Accès FTP de l'hébergement — copiez ce fichier en « deploiement.env » et remplissez-le.
# deploiement.env est ignoré par Git : vos mots de passe ne partent jamais sur GitHub.

# ── Exemple HOSTINGER (hPanel > Fichiers > Comptes FTP) ──
FTP_PROTOCOLE=ftp
FTP_HOTE=ftp.votre-domaine.fr
FTP_UTILISATEUR=u123456789
FTP_DOSSIER=/public_html

# ── Exemple OVH (Espace client > Hébergements > FTP-SSH) ──
# FTP_PROTOCOLE=sftp
# FTP_HOTE=ftp.clusterXXX.hosting.ovh.net
# FTP_UTILISATEUR=votrelogin
# FTP_DOSSIER=/www

# Laissez vide pour que le mot de passe soit demandé à chaque envoi (recommandé)
FTP_MOT_DE_PASSE=
